{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chapter_events.schema.json",
  "title": "Scripted chapter event chain (no LLM)",
  "type": "object",
  "required": [
    "chapter_id",
    "schema_version",
    "initial_state",
    "objectives",
    "events",
    "endings"
  ],
  "additionalProperties": false,
  "properties": {
    "chapter_id": {
      "type": "string",
      "pattern": "^C[0-9]+$"
    },
    "title_text": {
      "$ref": "#/$defs/text_id"
    },
    "schema_version": {
      "const": 1
    },
    "notes": {
      "type": "string"
    },
    "characters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name_text"
        ],
        "additionalProperties": false,
        "properties": {
          "name_text": {
            "$ref": "#/$defs/text_id"
          },
          "seat": {
            "type": [
              "string",
              "null"
            ]
          },
          "placeholder_traits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "initial_state": {
      "type": "object",
      "required": [
        "vars",
        "flags"
      ],
      "additionalProperties": false,
      "properties": {
        "vars": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flag"
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title_text",
          "deadline",
          "conditions"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title_text": {
            "$ref": "#/$defs/text_id"
          },
          "desc_text": {
            "$ref": "#/$defs/text_id"
          },
          "deadline": {
            "$ref": "#/$defs/turn_phase"
          },
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "var",
                "cmp",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "var": {
                  "type": "string"
                },
                "cmp": {
                  "$ref": "#/$defs/cmp"
                },
                "value": {
                  "type": "number"
                },
                "label_text": {
                  "$ref": "#/$defs/text_id"
                }
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "endings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title_text",
          "effects"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^END_"
          },
          "title_text": {
            "$ref": "#/$defs/text_id"
          },
          "body_text": {
            "$ref": "#/$defs/text_id"
          },
          "body_text_rules": {
            "$ref": "#/$defs/text_rules"
          },
          "effects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/effect"
            }
          },
          "illustration": {
            "type": "string",
            "pattern": "^C[0-9]+_IL[0-9]+$"
          }
        },
        "oneOf": [
          {
            "required": [
              "body_text"
            ]
          },
          {
            "required": [
              "body_text_rules"
            ]
          }
        ]
      }
    }
  },
  "$defs": {
    "text_id": {
      "type": "string",
      "minLength": 1
    },
    "flag": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "cmp": {
      "enum": [
        "==",
        "!=",
        ">",
        ">=",
        "<",
        "<="
      ]
    },
    "turn_phase": {
      "type": "object",
      "required": [
        "turn",
        "phase"
      ],
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "enum": [
            "start",
            "end"
          ]
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "flag"
          ],
          "additionalProperties": false,
          "properties": {
            "flag": {
              "$ref": "#/$defs/flag"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "var",
            "cmp",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "var": {
              "type": "string"
            },
            "cmp": {
              "$ref": "#/$defs/cmp"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "trait"
          ],
          "additionalProperties": false,
          "properties": {
            "trait": {
              "type": "object",
              "required": [
                "character",
                "trait"
              ],
              "additionalProperties": false,
              "properties": {
                "character": {
                  "type": "string"
                },
                "trait": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "objective"
          ],
          "additionalProperties": false,
          "properties": {
            "objective": {
              "type": "string"
            }
          }
        }
      ]
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "var",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "add",
                "set"
              ]
            },
            "var": {
              "type": "string"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "flag"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "set_flag",
                "clear_flag"
              ]
            },
            "flag": {
              "$ref": "#/$defs/flag"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "id",
            "target",
            "value",
            "turns"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "add_modifier"
            },
            "id": {
              "type": "string"
            },
            "target": {
              "type": "string"
            },
            "value": {
              "type": "number"
            },
            "turns": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "remove_modifier",
                "activate_objective"
              ]
            },
            "id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "set_turn_granularity"
            },
            "value": {
              "enum": [
                "seasonal",
                "monthly",
                "half_monthly"
              ]
            }
          }
        }
      ]
    },
    "text_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "if": {
            "$ref": "#/$defs/condition"
          },
          "text": {
            "$ref": "#/$defs/text_id"
          }
        }
      }
    },
    "next_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "goto"
        ],
        "additionalProperties": false,
        "properties": {
          "if": {
            "$ref": "#/$defs/condition"
          },
          "goto": {
            "type": "string"
          }
        }
      }
    },
    "option": {
      "type": "object",
      "required": [
        "id",
        "label_text",
        "effects"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label_text": {
          "$ref": "#/$defs/text_id"
        },
        "requires": {
          "$ref": "#/$defs/condition"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_rules": {
          "$ref": "#/$defs/next_rules"
        }
      },
      "oneOf": [
        {
          "required": [
            "next"
          ]
        },
        {
          "required": [
            "next_rules"
          ]
        }
      ]
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "trigger",
        "title_text",
        "options"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C[0-9]+_E"
        },
        "trigger": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "turn",
                "phase"
              ],
              "additionalProperties": false,
              "properties": {
                "turn": {
                  "type": "integer",
                  "minimum": 0
                },
                "phase": {
                  "enum": [
                    "start",
                    "end"
                  ]
                },
                "condition": {
                  "$ref": "#/$defs/condition"
                }
              }
            }
          ]
        },
        "title_text": {
          "$ref": "#/$defs/text_id"
        },
        "body_text": {
          "$ref": "#/$defs/text_id"
        },
        "body_text_rules": {
          "$ref": "#/$defs/text_rules"
        },
        "on_fire": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "illustration": {
          "type": "string",
          "pattern": "^C[0-9]+_IL[0-9]+$"
        }
      },
      "oneOf": [
        {
          "required": [
            "body_text"
          ]
        },
        {
          "required": [
            "body_text_rules"
          ]
        }
      ]
    }
  }
}