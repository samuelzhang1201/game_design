[node name="Carrack" unique_id=1057117186 instance=ExtResource("1_glb")]
editor_description = "One house type of the 3D map. Map3DLayerHouses draws every house of this type as ONE MultiMesh of this mesh with these surface materials (house_surface.gdshader, edited here: texture, roughness, role 1 wall / 2 tile roof / 0 untinted). The Houses node adds its colour variants and the weather to its own copies at run time; its sizes are data/map3d_houses.csv. A SHIP: bob_on rocks it on the swell about its origin, the waterline, which the layer floats on the sea (role ship)."

