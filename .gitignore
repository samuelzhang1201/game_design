.godot/
.DS_Store
.env
__pycache__/
.superpowers/
assets/flux/out/

# macOS archive junk from unzipped asset packs
assets/__MACOSX/
# The asset layout (owner 2026-09-30): assets/3D/{category}/{object}/ holds what
# the game uses, and its model_wip/ what produced it — Comfy reference art,
# Tripo exports, .blend work files, CC0 scans, downloaded sources. model_wip is
# local work, never committed, except its .gdignore (Godot must not import a
# work file) and the terrain's aerial pictures, the committed source of the
# ground's packed layers (tools/map3d/pack_aerial.py).
assets/3D/**/model_wip/**
!assets/3D/**/model_wip/**/
!assets/3D/**/model_wip/.gdignore
!assets/3D/terrain/model_wip/aerial/**
# The 3D map's Terrain3D build and its packed ground textures ARE committed
# (owner 2026-10-02: a developer on another machine pulls and runs the game
# with no Blender, ComfyUI or Python build) — tools/map3d/build_pack.sh still
# rebuilds them. Only the bake's raw intermediates stay local: build_world.gd
# imports them into the committed Terrain3D regions, and each is 128 MB, past
# a git host's limit for one file (the WAR ROOM reads the committed
# bake/height_war.r16 instead of height.r32).
assets/3D/terrain/*/bake/height.r32
assets/3D/terrain/*/bake/control.r32
assets/3D/terrain/*/bake/color.rgba8
# purchased audio pack, not yet used by the game
assets/audio/Sound FX Starter Pack Vol. 1/
# Godot's glTF importer EXTRACTED each mesh's embedded textures to loose files
# beside the .glb (gltf/embedded_image_handling=1). Since 2026-10-02 the houses
# and the units EMBED them as Basis Universal (=2: GPU-compressed, ~320 MB less
# video memory) and no longer read these files; the patterns stay for old
# checkouts' leftovers and for any .glb still set to extract.
assets/3D/buildings/*/*.jpg
assets/3D/buildings/*/*.jpg.import
assets/3D/buildings/*/*.png
assets/3D/buildings/*/*.png.import
assets/3D/units/*/*.jpg
assets/3D/units/*/*.jpg.import
assets/3D/units/*/*.png
assets/3D/units/*/*.png.import
assets/3D/war_room/*/*.jpg
assets/3D/war_room/*/*.jpg.import
assets/3D/war_room/*/*.png
assets/3D/war_room/*/*.png.import
# the unit tools' contact sheets
assets/3D/units/shots/
