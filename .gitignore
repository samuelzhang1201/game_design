.godot/
.DS_Store
.env
__pycache__/
.superpowers/
assets/flux/out/

# macOS archive junk from unzipped asset packs
assets/__MACOSX/
# 3D map: sources are local downloads (Poly Haven / ambientCG, CC0), everything
# else under assets/map3d is rebuilt by tools/map3d/ — see tools/map3d/README.md
assets/map3d/
# purchased audio pack, not yet used by the game
assets/Sound FX Starter Pack Vol. 1/
# Godot's glTF importer EXTRACTS each mesh's embedded textures to loose files
# beside the .glb (gltf/embedded_image_handling=1) and the imported scene
# depends on them. They are BUILD OUTPUT of the import, regenerated by
# `Godot --headless --import` on a fresh clone — but never delete them in a
# working checkout, or every house silently fails to load (2026-09-22).
assets/map3d_houses/*_albedo.jpg
assets/map3d_houses/*_albedo.png
assets/map3d_houses/*_normal.jpg
assets/map3d_houses/*_normal.png
assets/map3d_houses/*_albedo.jpg.import
assets/map3d_houses/*_albedo.png.import
assets/map3d_houses/*_normal.jpg.import
assets/map3d_houses/*_normal.png.import

# The 3D regiments' Hunyuan3D sources (~180 MB) and the bake's texture
# intermediates: never loaded by the game — tools/units3d reads them, and its
# OUTPUT (assets/units3d/*.glb, textures embedded) is what is committed.
assets/units3d/ai_src/
assets/units3d/*_albedo.jpg
assets/units3d/*_normal.jpg
assets/units3d/*_albedo.jpg.import
assets/units3d/*_normal.jpg.import
assets/units3d/*_atlas*.jpg
assets/units3d/*_atlas*.jpg.import
assets/units3d/*_base_ground*.jpg
assets/units3d/*_base_ground*.jpg.import

# Godot's extracted copies of the textures embedded in the hand-modelled house .glb files (regenerated on import)
assets/map3d_houses/*.jpg
assets/map3d_houses/*.jpg.import
