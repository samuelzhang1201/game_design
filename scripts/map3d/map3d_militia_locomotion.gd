class_name Map3DMilitiaLocomotion
extends RefCounted
## The militia's pivot for ANY committed turn (certifier provider; candidate only, no caller):
## the militiaman walks the infantry's authored stances on his own skeleton (`mil_rig`, the skirt's
## 30 bones), so this is Map3DInfantryLocomotion's solver on this body's own plan (generated by
## tools/units3d/soldier_arp/pivot_mapping.py --arm militia `plan`). The plan's `held` names the
## skirt's bones: they keep the pivot clip's keys at every turn, since those keys were made for the
## held legs (a skirt eased toward the entry pose is cut by a leg).

const Infantry = preload("res://scripts/map3d/map3d_infantry_locomotion.gd")
const Provider = preload("res://scripts/map3d/map3d_pivot_provider.gd")
const PLAN_PATH := "res://assets/3D/units/militia/militia_pivot_plan.json"


## Certifier provider (tools/units3d/certify_locomotion.py), through the shared shell.
static func pose(player: AnimationPlayer, skeleton: Skeleton3D, request: Dictionary) -> void:
	Provider.apply(solve, player, skeleton, request)


## Solves one phase of a `turn_udeg` pivot on `clip` (the clip whose sign matches the turn).
static func solve(player: AnimationPlayer, skeleton: Skeleton3D, clip: String, turn_udeg: int,
		phase: float) -> Dictionary:
	return Infantry.solve_plan(Infantry.load_plan(PLAN_PATH), player, skeleton, clip, turn_udeg, phase)
