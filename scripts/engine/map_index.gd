class_name MapIndex
extends RefCounted
## Decodes the state-index bitmap generated by tools/import_azgaar.gd:
## each land pixel carries its Azgaar state id as R | (G << 8), B = 0;
## pure white is water / no state. -1 means "nothing here".

static func decode(c: Color) -> int:
	if c.r8 == 255 and c.g8 == 255 and c.b8 == 255:
		return -1
	return c.r8 | (c.g8 << 8)

static func state_at(img: Image, px: Vector2i) -> int:
	if img == null or px.x < 0 or px.y < 0 \
			or px.x >= img.get_width() or px.y >= img.get_height():
		return -1
	return decode(img.get_pixelv(px))

## Generic decode for any two-byte index bitmap (states, provinces): the same
## encoding as state_at, which stays as the named alias.
static func id_at(img: Image, px: Vector2i) -> int:
	return state_at(img, px)

## The biome bitmap carries its id in R alone (13 biomes); white = none.
static func biome_at(img: Image, px: Vector2i) -> int:
	if img == null or px.x < 0 or px.y < 0 \
			or px.x >= img.get_width() or px.y >= img.get_height():
		return -1
	var c := img.get_pixelv(px)
	if c.r8 == 255 and c.g8 == 255 and c.b8 == 255:
		return -1
	return c.r8

## --- The sea's distance field (owner 2026-09-13, after the reference chart) --
## Every pixel's distance to the nearest LAND pixel, in px: a two-pass
## chamfer (1 across, sqrt 2 diagonal — within 8% of Euclidean), 0 on land.
## `land` is one byte per pixel, row-major, non-zero for land. Pure.
const DIAG := 1.4142135
const FAR := 1.0e9

static func distance_to_land(land: PackedByteArray, w: int, h: int) -> PackedFloat32Array:
	var d := PackedFloat32Array()
	d.resize(w * h)
	for i in w * h:
		d[i] = 0.0 if land[i] != 0 else FAR
	# Forward: from the neighbours above and to the left.
	for y in h:
		for x in w:
			var i := y * w + x
			var best := d[i]
			if best == 0.0:
				continue
			if x > 0:
				best = minf(best, d[i - 1] + 1.0)
			if y > 0:
				best = minf(best, d[i - w] + 1.0)
				if x > 0:
					best = minf(best, d[i - w - 1] + DIAG)
				if x < w - 1:
					best = minf(best, d[i - w + 1] + DIAG)
			d[i] = best
	# Backward: from the neighbours below and to the right.
	for y in range(h - 1, -1, -1):
		for x in range(w - 1, -1, -1):
			var i := y * w + x
			var best := d[i]
			if best == 0.0:
				continue
			if x < w - 1:
				best = minf(best, d[i + 1] + 1.0)
			if y < h - 1:
				best = minf(best, d[i + w] + 1.0)
				if x < w - 1:
					best = minf(best, d[i + w + 1] + DIAG)
				if x > 0:
					best = minf(best, d[i + w - 1] + DIAG)
			d[i] = best
	return d

## --- Stamping polylines into a mask (2026-09-17) -----------------------------
## Every pixel within `radii[i]` px of line `i` becomes 1. `lines` holds
## PackedVector2Array courses in the MASK's own pixel space (divide native
## coordinates by the bake's scale before calling). Segments are walked at
## half-pixel steps so no pixel is skipped on a diagonal. The pack's 180
## river courses touch only a few thousand pixels, so this costs nothing
## next to the per-pixel passes around it. Pure; a bake step, never runtime.
static func stamp_polylines(w: int, h: int, lines: Array, radii: PackedFloat32Array) -> PackedByteArray:
	var mask := PackedByteArray()
	mask.resize(w * h)
	for i in lines.size():
		var pts: PackedVector2Array = lines[i]
		var r := 0.0 if i >= radii.size() else maxf(radii[i], 0.0)
		if pts.size() == 1:
			_stamp_disc(mask, w, h, pts[0], r)
			continue
		for s in maxi(pts.size() - 1, 0):
			var a := pts[s]
			var b := pts[s + 1]
			var steps := maxi(int(a.distance_to(b) * 2.0), 1)
			for t in steps + 1:
				_stamp_disc(mask, w, h, a.lerp(b, float(t) / float(steps)), r)
	return mask

static func _stamp_disc(mask: PackedByteArray, w: int, h: int, p: Vector2, r: float) -> void:
	var cx := int(round(p.x))
	var cy := int(round(p.y))
	var ri := int(ceil(r))
	for dy in range(-ri, ri + 1):
		for dx in range(-ri, ri + 1):
			if Vector2(dx, dy).length() > r:
				continue
			var x := cx + dx
			var y := cy + dy
			if x >= 0 and y >= 0 and x < w and y < h:
				mask[y * w + x] = 1

## --- The relief's synthesized detail (owner 2026-09-17, approach A) ----------
## Ridged fractal noise over the whole field, 0..1, row-major. The pack has
## ONE height per Voronoi cell (~26 native px across) and vertices.csv has
## no heights at all, so there is no finer truth to recover: the landforms
## below a cell are invented. Ridged, because a ridgeline is the feature a
## satellite view reads terrain by; domain-warped so the ridges run in
## coherent directions instead of as isotropic blobs. The seed is DATA
## (balance.csv map_relief_detail_seed) — a look, never simulation. Pure.
static func detail_field(w: int, h: int, seed_value: int, freq_px: float,
		octaves: int, warp_px: float) -> PackedFloat32Array:
	var noise := FastNoiseLite.new()
	noise.noise_type = FastNoiseLite.TYPE_SIMPLEX
	noise.seed = seed_value
	noise.frequency = 1.0 / maxf(freq_px, 1.0)
	noise.fractal_type = FastNoiseLite.FRACTAL_RIDGED
	noise.fractal_octaves = maxi(octaves, 1)
	if warp_px > 0.0:
		noise.domain_warp_enabled = true
		noise.domain_warp_amplitude = warp_px
		noise.domain_warp_frequency = 1.0 / maxf(freq_px * 2.0, 1.0)
	var out := PackedFloat32Array()
	out.resize(w * h)
	for y in h:
		for x in w:
			out[y * w + x] = clampf(noise.get_noise_2d(float(x), float(y)) * 0.5 + 0.5, 0.0, 1.0)
	return out

## The biome index (land pixels carry an id, water is white) baked into an
## L8 image: each pixel its distance to land in px, capped at 255. Written
## by tools/import_azgaar.gd as world_sea_distance.png (and by
## tools/bake_sea_distance.gd from an existing index); SeaLayer's shader
## reads it. Slow in GDScript over a whole canvas — seconds — which is why
## it is baked, never built at runtime.
static func bake_sea_distance(biome: Image) -> Image:
	var w := biome.get_width()
	var h := biome.get_height()
	var land := PackedByteArray()
	land.resize(w * h)
	for y in h:
		for x in w:
			land[y * w + x] = 1 if biome_at(biome, Vector2i(x, y)) >= 0 else 0
	var d := distance_to_land(land, w, h)
	var bytes := PackedByteArray()
	bytes.resize(w * h)
	for i in w * h:
		bytes[i] = mini(int(d[i] + 0.5), 255)
	return Image.create_from_data(w, h, false, Image.FORMAT_L8, bytes)

## --- The biomes layer's weight maps (experiment 2026-09-14) -----------------
## Per biome 1..count, its share of the LAND within `radius` low-res px of
## every point, at 1/`scale` of the index's resolution: the land and each
## biome's pixels are counted per low-res cell, box-summed twice (two box
## passes are near a Gaussian), and the biome's sum divided by the land's,
## so the shares sum to one wherever any land is near and the coast keeps a
## whole tile — the mesh clips it, so nothing bleeds into the sea. Four
## biomes per RGBA8 image, biome 4N+1 in R of image N ... 4N+4 in A; a
## biome beyond `count` is 0. Pure; a bake, never a runtime step.
static func bake_biome_weights(biome: Image, scale: int, radius: int, count: int) -> Array[Image]:
	var w := biome.get_width()
	var h := biome.get_height()
	var s := maxi(scale, 1)
	var lw := ceili(float(w) / float(s))
	var lh := ceili(float(h) / float(s))
	var n := lw * lh
	var land := PackedFloat32Array()
	land.resize(n)
	# Every biome's counts in one flat array, biome k at k * n.
	var per := PackedFloat32Array()
	per.resize(n * count)
	for y in h:
		for x in w:
			var b := biome_at(biome, Vector2i(x, y))
			if b < 1 or b > count:
				continue
			@warning_ignore("integer_division")  # the low-res cell a full-res pixel falls in
			var i := (y / s) * lw + (x / s)
			land[i] += 1.0
			per[(b - 1) * n + i] += 1.0
	land = box_sum(box_sum(land, lw, lh, radius), lw, lh, radius)
	var blurred := PackedFloat32Array()
	for k in count:
		blurred.append_array(box_sum(box_sum(per.slice(k * n, (k + 1) * n), lw, lh, radius), lw, lh, radius))
	var images: Array[Image] = []
	for img_i in ceili(float(count) / 4.0):
		var bytes := PackedByteArray()
		bytes.resize(n * 4)
		for i in n:
			var l := land[i]
			for c in 4:
				var k := img_i * 4 + c
				var v := 0.0
				if k < count and l > 0.0:
					v = blurred[k * n + i] / l
				bytes[i * 4 + c] = clampi(int(v * 255.0 + 0.5), 0, 255)
		images.append(Image.create_from_data(lw, lh, false, Image.FORMAT_RGBA8, bytes))
	return images

## The sum of `src` over the (2r+1)-square around each point, clipped at
## the edges (no padding, no division — the bake takes ratios of two sums,
## so the window's size cancels). Separable, running sums: O(n). Pure.
static func box_sum(src: PackedFloat32Array, w: int, h: int, r: int) -> PackedFloat32Array:
	if r <= 0:
		return src.duplicate()
	var tmp := PackedFloat32Array()
	tmp.resize(w * h)
	for y in h:
		var row := y * w
		var acc := 0.0
		for x in mini(r, w - 1) + 1:
			acc += src[row + x]
		for x in w:
			tmp[row + x] = acc
			var add := x + r + 1
			if add < w:
				acc += src[row + add]
			var drop := x - r
			if drop >= 0:
				acc -= src[row + drop]
	var out := PackedFloat32Array()
	out.resize(w * h)
	for x in w:
		var acc := 0.0
		for y in mini(r, h - 1) + 1:
			acc += tmp[y * w + x]
		for y in h:
			out[y * w + x] = acc
			var add := y + r + 1
			if add < h:
				acc += tmp[add * w + x]
			var drop := y - r
			if drop >= 0:
				acc -= tmp[drop * w + x]
	return out

## --- High ground and relief (owner 2026-09-17, choice B) --------------------
## The pack has no mountains: Azgaar's biomes are CLIMATE, and how high the
## ground stands lives on the cell. raise_high_ground rewrites a LAND
## pixel's biome id to 13 (hill), 14 (mountain) or 15 (peak) by the height
## of the cell it falls in, so the weight bake blends high ground in exactly
## like a biome and the shader needs no second path. `cells` is the pack's
## world_cell_index.png (id_at; white = water) and `heights` is indexed by
## cell id. Water is left as the biome index had it. Pure.
static func raise_high_ground(biome: Image, cells: Image, heights: PackedInt32Array,
		hill: int, mountain: int, peak: int) -> Image:
	var w := biome.get_width()
	var h := biome.get_height()
	var out := biome.duplicate() as Image
	out.convert(Image.FORMAT_RGB8)
	for y in h:
		for x in w:
			var px := Vector2i(x, y)
			if biome_at(biome, px) < 1:
				continue  # the sea keeps the index's own white
			var cell := id_at(cells, px)
			if cell < 0 or cell >= heights.size():
				continue
			var height := heights[cell]
			var id := 0
			if height >= peak:
				id = 15
			elif height >= mountain:
				id = 14
			elif height >= hill:
				id = 13
			if id > 0:
				out.set_pixel(x, y, Color8(id, 0, 0))
	return out

## Every pixel's height as grey (0..100 of the pack's scale -> 0..255), at
## 1/`scale` of the cell index's resolution and box-smoothed twice at
## `radius` — the same two-pass near-Gaussian the biome weights take, for
## the same reason: a cell's flat height would otherwise read as a cliff at
## its edge. The shader takes a SLOPE from this and lights it, which is the
## only way an aerial photograph gets relief (it has none of its own).
## Water counts as height 0, and the land mesh clips the layer anyway. Pure.
## With `gain` above 0 the field also carries synthesized landforms: `detail`
## (0..1, row-major, at the OUTPUT resolution) scaled by `gain` in height
## units, weighted by how far the smoothed ground already stands above
## `floor_height`, and multiplied by `suppression` (0 holds it down, 1 lets it
## through) so rivers and the coast keep their valleys. All four default to
## off, so a four-argument call behaves exactly as it did before.
static func bake_relief(cells: Image, heights: PackedInt32Array, scale: int, radius: int,
		detail: PackedFloat32Array = PackedFloat32Array(),
		suppression: PackedFloat32Array = PackedFloat32Array(),
		gain: float = 0.0, floor_height: float = 0.0) -> Image:
	var w := cells.get_width()
	var h := cells.get_height()
	var s := maxi(scale, 1)
	var lw := ceili(float(w) / float(s))
	var lh := ceili(float(h) / float(s))
	var n := lw * lh
	var total := PackedFloat32Array()
	total.resize(n)
	var count := PackedFloat32Array()
	count.resize(n)
	for y in h:
		for x in w:
			@warning_ignore("integer_division")  # the low-res cell this pixel falls in
			var i := (y / s) * lw + (x / s)
			count[i] += 1.0
			var cell := id_at(cells, Vector2i(x, y))
			if cell >= 0 and cell < heights.size():
				total[i] += float(heights[cell])
	total = box_sum(box_sum(total, lw, lh, radius), lw, lh, radius)
	count = box_sum(box_sum(count, lw, lh, radius), lw, lh, radius)
	var bytes := PackedByteArray()
	bytes.resize(n)
	var span := maxf(100.0 - floor_height, 1.0)
	for i in n:
		var v := 0.0
		if count[i] > 0.0:
			v = total[i] / count[i]
		# Synthesized landforms (owner 2026-09-17, approach A): added in
		# height units, weighted by how high the ground already is so a
		# plain stays flat, and held down near rivers and the coast so an
		# invented ridge never cuts across real pack data.
		if gain > 0.0 and i < detail.size():
			var h_norm := clampf((v - floor_height) / span, 0.0, 1.0)
			var sup := 1.0 if i >= suppression.size() else suppression[i]
			v += gain * h_norm * sup * detail[i]
		bytes[i] = clampi(int(v * 255.0 / 100.0 + 0.5), 0, 255)
	return Image.create_from_data(lw, lh, false, Image.FORMAT_L8, bytes)

## --- Rasterising an index bitmap (2026-09-13) --------------------------------
## `polys[i]` filled with `ids[i]` in the two-byte encoding id_at reads (R =
## id & 0xFF, G = id >> 8), untouched pixels white — the same even-odd
## scanline fill tools/import_azgaar.gd uses for the state, province and
## biome indexes, so a bitmap baked from a pack matches one the importer
## wrote. Ids must be below 65536. Pure; slow in GDScript over a whole
## canvas (a second or two), so it is a bake, never a runtime step.
static func rasterize(polys: Array, ids: PackedInt32Array, w: int, h: int) -> Image:
	var buf := PackedByteArray()
	buf.resize(w * h * 3)
	buf.fill(255)
	for i in polys.size():
		var poly: PackedVector2Array = polys[i]
		if poly.size() < 3:
			continue
		var id := ids[i]
		if id < 0:
			continue
		_fill(buf, w, h, poly, id)
	return Image.create_from_data(w, h, false, Image.FORMAT_RGB8, buf)

static func _fill(buf: PackedByteArray, w: int, h: int, poly: PackedVector2Array, id: int) -> void:
	var r := id & 0xFF
	var g := (id >> 8) & 0xFF
	var y_min := poly[0].y
	var y_max := poly[0].y
	for p in poly:
		y_min = minf(y_min, p.y)
		y_max = maxf(y_max, p.y)
	var n := poly.size()
	for y in range(maxi(0, int(y_min)), mini(h - 1, int(y_max) + 1) + 1):
		var yc := float(y) + 0.5
		var xs: Array[float] = []
		for i in n:
			var a := poly[i]
			var b := poly[(i + 1) % n]
			if (a.y <= yc and yc < b.y) or (b.y <= yc and yc < a.y):
				xs.append(a.x + (yc - a.y) / (b.y - a.y) * (b.x - a.x))
		xs.sort()
		var j := 0
		while j + 1 < xs.size():
			for x in range(maxi(0, int(xs[j] + 0.5)), mini(w - 1, int(xs[j + 1] - 0.5)) + 1):
				var o := (y * w + x) * 3
				buf[o] = r
				buf[o + 1] = g
				buf[o + 2] = 0
			j += 2
