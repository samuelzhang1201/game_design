			"head": Vector3(row.head[0], row.head[1], row.head[2]),
			"tail": Vector3(row.tail[0], row.tail[1], row.tail[2])})
		native[row.name] = _matrix(row.native)
	var chains: Dictionary = {}
	for side: String in ["L", "R"]:
		chains["FrontHoof." + side] = _chain([
			"FrontScapula." + side, "FrontUpperArm." + side,
			"FrontForearm." + side, "FrontCannon." + side, "FrontHoof." + side], bones)
		chains["HindHoof." + side] = _chain([
			"HindThigh." + side, "HindShin." + side,
			"HindCannon." + side, "HindHoof." + side], bones)
	return {"rest": {"version": 1, "turn_axis": Vector3(0, 0, -1),
		"bones": bones, "chains": chains}, "native": native}


func _chain(names: Array, bones: Array) -> Dictionary:
	var globals: Dictionary = {}
	for row: Dictionary in bones:
		globals[row.name] = row.bind if row.parent == "" else globals[row.parent] * row.bind
	var rotation_limits: Array = []
	for _name: String in names:
		rotation_limits.append(PI)
	var bend_limits: Array = []
	var bend_normals: Array = []
	var parent: String = ""
	for row: Dictionary in bones:
		if row.name == names[0]:
			parent = row.parent
	var parent_basis: Basis = globals[parent].basis
	for i: int in range(1, names.size() - 1):
		var previous: Vector3 = globals[names[i - 1]].origin
		var joint: Vector3 = globals[names[i]].origin
		var next: Vector3 = globals[names[i + 1]].origin
		bend_limits.append(Vector2(-PI, PI))
		bend_normals.append((parent_basis.inverse() * (joint - previous).cross(next - joint)).normalized())
	return {"bones": names, "rotation_limits": rotation_limits,
		"bend_limits": bend_limits, "bend_normals": bend_normals}


func _globals(rest: Dictionary, locals: Dictionary) -> Dictionary:
	var out: Dictionary = {}
	for bone: Dictionary in rest.bones:
		out[bone.name] = locals[bone.name] if bone.parent == "" else out[bone.parent] * locals[bone.name]
	return out


func _contacts(rest: Dictionary, native: Dictionary, angle: float) -> Dictionary:
	var globals: Dictionary = _globals(rest, native)
	var turn: Transform3D = Transform3D(Basis(rest.turn_axis, deg_to_rad(angle)), Vector3.ZERO)
	var zero: Transform3D = Transform3D(Basis(Vector3.ZERO, Vector3.ZERO, Vector3.ZERO), Vector3.ZERO)
	var out: Dictionary = {}
	for hoof: String in rest.chains:
		# Explicit swing declaration: no claim that all native phase.37 hooves support weight.
		out[hoof] = {"offset": Transform3D.IDENTITY, "segments": [{
			"start": 0.0, "end": 1.0, "mode": "swing",
			"from": globals[hoof], "to": turn * globals[hoof],
			"from_derivative": zero, "to_derivative": zero}]}
	return out


func test_arbitrary_native_phase037_entry_and_exit_preserve_every_local_and_skin_matrix() -> void:
	# Catches the canonical-idle endpoint remap: source phase.37 hoof-tail
	# offsets from idle are .132103/.284634/.392469/.109140 metres.
	# Equal full native locals and immutable binds imply equal skin matrices
	# for every mesh vertex, including multi-weight mounted equipment.
	assert_true(ResourceLoader.exists(HELPER_PATH), "Required pure cavalry helper is missing")
	if not ResourceLoader.exists(HELPER_PATH):
		return
	var solver: Script = load(HELPER_PATH)
	var fixture: Dictionary = _native_case()
	var native: Dictionary = fixture.native
	var rest: Dictionary = fixture.rest
	var rest_before: Dictionary = rest.duplicate(true)
	var pose: Dictionary = {"locals": native, "entry": native.duplicate(true), "exit": native.duplicate(true)}
	var pose_before: Dictionary = pose.duplicate(true)
	var contacts: Dictionary = _contacts(rest, native, 90.0)
	var contacts_before: Dictionary = contacts.duplicate(true)
	for phase: float in [0.0, 1.0]:
		var operation: Dictionary = {"start_heading": 350.0, "end_heading": 80.0,
			"turn_degrees": 90.0, "duration": 2.3, "phase": phase,
			"entry_phase": 0.37, "exit_phase": 0.37}
		var operation_before: Dictionary = operation.duplicate(true)
		var result: Dictionary = solver.sample(rest, pose, operation, contacts)
		assert_true(result.get("ok", false), "Compatible native endpoint must be solved: " + str(result))
		if not result.get("ok", false):
			continue
		assert_eq(result.locals.size(), 53, "No limb-only subset may claim full pose equality")
		for name: String in native:
			assert_eq(result.locals.get(name), native[name], name + " full native affine local")
		assert_eq(operation, operation_before)
		result.locals.erase("root")
		assert_true(native.has("root"), "Output must not alias caller dictionaries")
	assert_eq(rest, rest_before)
	assert_eq(pose, pose_before)
	assert_eq(contacts, contacts_before)


func _operation(angle: float, phase: float, start: float = 0.0) -> Dictionary:
	return {"start_heading": start, "end_heading": fposmod(start + angle, 360.0),
		"turn_degrees": angle, "duration": 2.3, "phase": phase,
		"entry_phase": 0.37, "exit_phase": 0.37}


func _pose(native: Dictionary) -> Dictionary:
	return {"locals": native.duplicate(true), "entry": native.duplicate(true), "exit": native.duplicate(true)}


func _sample(rest: Variant, pose: Variant, operation: Variant, contacts: Variant) -> Dictionary:
	var solver: Script = load(HELPER_PATH)
	return solver.sample(rest, pose, operation, contacts)


func _simple_bone(name: String, parent: String, origin: Vector3, tail: Vector3) -> Dictionary:
	return {"name": name, "parent": parent, "bind": Transform3D(Basis.IDENTITY, origin),
		"bind_global": Transform3D.IDENTITY,
		"head": Vector3.ZERO, "tail": tail}


func _synthetic_case() -> Dictionary:
	# Four unit fore spans, three unit hind spans; the bends are hand-built
	# right angles, not nominal bone.length or an implementation helper.
	var bones: Array = [_simple_bone("root", "", Vector3.ZERO, Vector3.UP),
		_simple_bone("Chest", "root", Vector3.ZERO, Vector3.UP),
		_simple_bone("Pelvis", "root", Vector3.ZERO, Vector3.UP)]
	for name: String in ["Saddle", "R_Hips", "R_Chest", "Lance", "Shield", "Reins", "Head", "Tail"]:
		bones.append(_simple_bone(name, "root", Vector3(0.2, 4, 0.1), Vector3.UP))
	var chains: Dictionary = {}
	for side: String in ["L", "R"]:
		var x: float = 0.5 if side == "L" else -0.5
		for front: bool in [true, false]:
			var names: Array = (["FrontScapula.", "FrontUpperArm.", "FrontForearm.", "FrontCannon.", "FrontHoof."]
				if front else ["HindThigh.", "HindShin.", "HindCannon.", "HindHoof."])
			for i: int in names.size():
				names[i] += side
			var z: float = -1.0 if front else 1.0
			var points: Array[Vector3] = [Vector3(x, 3, z), Vector3(x, 2, z), Vector3(x + 1, 2, z), Vector3(x + 1, 1, z)]
			if front:
				points.append(Vector3(x + 2, 1, z))
			for i: int in names.size():
				var parent: String = ("Chest" if front else "Pelvis") if i == 0 else names[i - 1]
				var origin: Vector3 = points[i] if i == 0 else points[i] - points[i - 1]
				var tail: Vector3 = Vector3(0, -0.2, 0) if i == names.size() - 1 else points[i + 1] - points[i]
				bones.append(_simple_bone(names[i], parent, origin, tail))
			chains[names[-1]] = _chain(names, bones)
	var native: Dictionary = {}
	for bone: Dictionary in bones:
		native[bone.name] = bone.bind
	_freeze_bind_globals(bones)
	return {"rest": {"version": 1, "turn_axis": Vector3.UP, "bones": bones, "chains": chains}, "native": native}


func _assert_native_affines_and_nonlimbs(rest: Dictionary, native: Dictionary, result: Dictionary) -> void:
	var limb_names: Array = []
	for chain: Dictionary in rest.chains.values():
		limb_names.append_array(chain.bones)
	assert_eq(result.locals.size(), native.size())
	for name: String in native:
		var got: Transform3D = result.locals[name]
		var original: Transform3D = native[name]
		assert_eq(got.origin, original.origin, name + " native local origin")
		if not name in limb_names:
			assert_eq(got, original, name + " nonlimb/rider/gear passthrough")
		else:
			var gram: Basis = got.basis.transposed() * got.basis
			var want: Basis = original.basis.transposed() * original.basis
			for axis: int in 3:
				assert_almost_eq(gram[axis].distance_to(want[axis]), 0.0, 0.00001, name + " full native stretch/shear")
	var globals: Dictionary = _globals(rest, result.locals)
	for chain: Dictionary in rest.chains.values():
		for i: int in range(1, chain.bones.size()):
			var child: Dictionary = {}
			var parent: Dictionary = {}
			for bone: Dictionary in rest.bones:
				if bone.name == chain.bones[i]:
					child = bone
				if bone.name == chain.bones[i - 1]:
					parent = bone
			assert_almost_eq((globals[child.name] * child.head).distance_to(globals[parent.name] * parent.tail), 0.0, 0.00001, child.name + " anatomical connectivity")


func test_hand_computed_four_and_three_span_contacts_preserve_full_native_affines() -> void:
	var fixture: Dictionary = _synthetic_case()
	var rest: Dictionary = fixture.rest
	var contacts: Dictionary = _contacts(rest, fixture.native, 90.0)
	var result: Dictionary = _sample(rest, _pose(fixture.native), _operation(90.0, 0.5), contacts)
	assert_true(result.ok, str(result.diagnostics))
	if not result.ok:
		return
	var globals: Dictionary = _globals(rest, result.locals)
	var turn: Transform3D = Transform3D(Basis(Vector3.UP, PI / 4), Vector3.ZERO)
	# Cubic with zero endpoint slopes is exactly its endpoint midpoint at .5:
	# R90(x,y,z)=(z,y,-x). The expected sole coordinates are hand-calculated.
	var expected: Dictionary = {"FrontHoof.L": Vector3(0.75, 1, -1.75),
		"FrontHoof.R": Vector3(0.25, 1, -1.25),
		"HindHoof.L": Vector3(1.25, 1, -0.25),
		"HindHoof.R": Vector3(0.75, 1, 0.25)}
	for hoof: String in expected:
		var world: Transform3D = turn * globals[hoof]
		assert_almost_eq(world.origin.distance_to(expected[hoof]), 0.0, 0.00001, hoof + " full-chain position")
		for axis: int in 3:
			assert_almost_eq(world.basis[axis].distance_to(turn.basis[axis]), 0.0, 0.00001, hoof + " full contact orientation")
	_assert_native_affines_and_nonlimbs(rest, fixture.native, result)


func _segment(start: float, end: float, first: Transform3D, last: Transform3D, mode: String = "swing") -> Dictionary:
	var zero: Transform3D = Transform3D(Basis(Vector3.ZERO, Vector3.ZERO, Vector3.ZERO), Vector3.ZERO)
	return {"start": start, "end": end, "mode": mode, "from": first, "to": last,
		"from_derivative": zero, "to_derivative": zero}


func _source_pivot_contacts(rest: Dictionary, native: Dictionary, angle: float) -> Dictionary:
	# An explicit numerical support schedule on source anatomy, not a claim
	# of an authored animation/skin certificate. Fore soles support through
	# .6; hind hooves swing to a raised, reoriented midpoint before landing.
	var globals: Dictionary = _globals(rest, native)
	var out: Dictionary = {}
	for hoof: String in rest.chains:
		var offset: Transform3D = Transform3D.IDENTITY
		for bone: Dictionary in rest.bones:
			if bone.name == hoof:
				offset.origin = bone.tail
		var first: Transform3D = globals[hoof] * offset
		var end: Transform3D = Transform3D(Basis(rest.turn_axis, deg_to_rad(angle)), Vector3.ZERO) * first
		var segments: Array = []
		if hoof.begins_with("Front"):
			var middle: Transform3D = Transform3D(Basis(rest.turn_axis, deg_to_rad(angle * 0.8)), Vector3(0, 0, 0.45)) * first
			segments = [_segment(0.0, 0.6, first, first, "stance"),
				_segment(0.6, 0.8, first, middle), _segment(0.8, 1.0, middle, end)]
		else:
			var middle: Transform3D = Transform3D(Basis(rest.turn_axis, deg_to_rad(angle * 0.5)), Vector3(0, 0, 0.6)) * first
			segments = [_segment(0.0, 0.5, first, middle), _segment(0.5, 1.0, middle, end)]
		out[hoof] = {"offset": offset, "segments": segments}
	return out


func test_actual_static90_all_hooves_follow_declared_contacts_without_root_or_rider_changes() -> void:
	var fixture: Dictionary = _native_case()
	var rest: Dictionary = fixture.rest
	var native: Dictionary = {}
	for bone: Dictionary in rest.bones:
		native[bone.name] = bone.bind
	var globals: Dictionary = _globals(rest, native)
	var contacts: Dictionary = _source_pivot_contacts(rest, native, 180.0)
	var before: Dictionary = {"rest": rest, "pose": _pose(native), "contacts": contacts}.duplicate(true)
	var result: Dictionary = _sample(rest, before.pose.duplicate(true), _operation(180.0, 0.5), contacts)
	assert_true(result.ok, "Source static90 is a contact solve regression, never reject-as-PASS: " + str(result.diagnostics))
	if not result.ok:
		return
	var solved: Dictionary = _globals(rest, result.locals)
	var turn: Transform3D = Transform3D(Basis(rest.turn_axis, PI / 2), Vector3.ZERO)
	var slips: Dictionary = {"FrontHoof.L": 0.6560120833, "FrontHoof.R": 0.6804541725,
		"HindHoof.L": 1.2392126125, "HindHoof.R": 0.9114000393}
	for hoof: String in slips:
		var anchor: Transform3D = contacts[hoof].segments[0].from
		assert_almost_eq((turn * anchor).origin.distance_to(anchor.origin), slips[hoof], 0.00001, hoof + " observed uncorrected slip")
		var want: Transform3D = anchor if hoof.begins_with("Front") else contacts[hoof].segments[0].to
		var got: Transform3D = turn * solved[hoof] * contacts[hoof].offset
		assert_almost_eq(got.origin.distance_to(want.origin), 0.0, 0.00001, hoof + " declared stance/swing sole")
		for axis: int in 3:
			assert_almost_eq(got.basis[axis].distance_to(want.basis[axis]), 0.0, 0.00001, hoof + " full stance/swing affine orientation")
	_assert_native_affines_and_nonlimbs(rest, native, result)
	assert_eq(rest, before.rest)
	assert_eq(contacts, before.contacts)


func test_both_turn_signs_nearzero_and_positive180_tie_have_finite_interior_contacts() -> void:
	var fixture: Dictionary = _synthetic_case()
	var rest: Dictionary = fixture.rest
	for angle: float in [-90.0, -0.00000001, 0.0, 0.00000001, 90.0, 180.0]:
		var contacts: Dictionary = _contacts(rest, fixture.native, angle)
		if angle == 180.0:
			# Lift while swinging so the chord is physically reachable; a full
			# rigid 180 orientation must not become the zero matrix at .5.
			for contact: Dictionary in contacts.values():
				contact.segments[0].from_derivative.origin = Vector3(0, 2.4, 0)
				contact.segments[0].to_derivative.origin = Vector3(0, -2.4, 0)
		var op: Dictionary = _operation(angle, 0.5, 350.0)
		var result: Dictionary = _sample(rest, _pose(fixture.native), op, contacts)
		assert_true(result.ok, "angle=" + str(angle) + " " + str(result.diagnostics))
		if result.ok:
			_assert_native_affines_and_nonlimbs(rest, fixture.native, result)


