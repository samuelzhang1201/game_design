func _assert_rejected(rest: Variant, pose: Variant, operation: Variant, contacts: Variant, expected_reason: String) -> void:
	var result: Dictionary = _sample(rest, pose, operation, contacts)
	assert_false(result.ok)
	assert_eq(result.locals, {}, "A rejected later hoof must never leak a partial pose")
	assert_eq(result.diagnostics.get("reason", ""), expected_reason)


func test_raw_unknown_nonfinite_singular_timing_sign_and_rest_laundering_reject_atomically() -> void:
	var fixture: Dictionary = _synthetic_case()
	var rest: Dictionary = fixture.rest
	var pose: Dictionary = _pose(fixture.native)
	var op: Dictionary = _operation(90.0, 0.5)
	var contacts: Dictionary = _contacts(rest, fixture.native, 90.0)
	var valid: Dictionary = _sample(rest, pose, op, contacts)
	assert_true(valid.ok, "Negative fixture must first pass unchanged: " + str(valid.diagnostics))
	if not valid.ok:
		return
	for raw: Variant in [null, false, 1, "rest", [], Vector3.ZERO]:
		_assert_rejected(raw, pose, op, contacts, "nonfinite_or_raw_type" if typeof(raw) in [TYPE_NIL, TYPE_BOOL] else "schema")
	var changed: Dictionary = op.duplicate(true)
	changed["phase"] = 1
	_assert_rejected(rest, pose, changed, contacts, "operation_type")
	for field: String in ["phase", "duration", "turn_degrees"]:
		for value: float in [NAN, INF, -INF]:
			changed = op.duplicate(true)
			changed[field] = value
			_assert_rejected(rest, pose, changed, contacts, "nonfinite_or_raw_type")
	for alteration: Dictionary in [{"phase": -0.01}, {"phase": 1.01}, {"duration": 0.0},
		{"entry_phase": 1.0}, {"exit_phase": -0.1}, {"turn_degrees": -90.0},
		{"turn_degrees": -180.0}, {"end_heading": 360.0}, {"start_heading": -0.01}, {"extra": 0.0}]:
		changed = op.duplicate(true)
		changed.merge(alteration, true)
		_assert_rejected(rest, pose, changed, contacts, "schema" if alteration.has("extra") else ("signed_shortest_turn" if alteration.get("turn_degrees") == -90.0 else "operation_domain"))
	var bad_pose: Dictionary = pose.duplicate(true)
	bad_pose.locals.erase("Lance")
	_assert_rejected(rest, bad_pose, op, contacts, "locals:pose_schema")
	bad_pose = pose.duplicate(true)
	bad_pose.locals["unknown_bone"] = Transform3D.IDENTITY
	_assert_rejected(rest, bad_pose, op, contacts, "locals:pose_schema")
	bad_pose = pose.duplicate(true)
	bad_pose.locals["root"].basis = Basis(Vector3.ZERO, Vector3.UP, Vector3.BACK)
	_assert_rejected(rest, bad_pose, op, contacts, "locals:pose_affine")
	var bad_rest: Dictionary = rest.duplicate(true)
	bad_rest.bones[0].bind.basis = Basis(Vector3.ZERO, Vector3.UP, Vector3.BACK)
	_assert_rejected(bad_rest, pose, op, contacts, "bone_data")
	bad_rest = rest.duplicate(true)
	for bone: Dictionary in bad_rest.bones:
		if bone.name == "FrontForearm.L":
			bone.bind.origin += Vector3(0.2, 0, 0)
	_assert_rejected(bad_rest, pose, op, contacts, "bind_global_mismatch")
	var bad_contacts: Dictionary = contacts.duplicate(true)
	bad_contacts["FrontHoof.L"].segments[0].mode = "maybe"
	_assert_rejected(rest, pose, op, bad_contacts, "FrontHoof.L:segment_data")
	bad_contacts = contacts.duplicate(true)
	bad_contacts["FrontHoof.L"].segments[0].start = 0.1
	_assert_rejected(rest, pose, op, bad_contacts, "FrontHoof.L:contact_partition")


func test_impossible_intermediate_contact_and_joint_limits_never_leak_partial_pose() -> void:
