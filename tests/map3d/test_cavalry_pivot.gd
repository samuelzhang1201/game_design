func test_actual_native_keys_and_adverse_interpolated_entry_exit_keep_all53_locals_and_solve_interior() -> void:
	var fixture: Dictionary = _native_case()
	var rest: Dictionary = fixture.rest
	var samples: Array = JSON.parse_string(MARCH_SAMPLES)
	for index: int in samples.size():
		var first: Dictionary = samples[index]
		var last: Dictionary = samples[(index + 1) % samples.size()]
		var entry: Dictionary = {}
		var exit_pose: Dictionary = {}
		var middle_pose: Dictionary = {}
		for name: String in first.locals:
			entry[name] = _matrix(first.locals[name])
			exit_pose[name] = _matrix(last.locals[name])
			middle_pose[name] = _matrix(samples[5].locals[name])
		var entry_globals: Dictionary = _globals(rest, entry)
		var exit_globals: Dictionary = _globals(rest, exit_pose)
		var middle_globals: Dictionary = _globals(rest, middle_pose)
		var angle: float = -90.0 if index % 2 == 0 else 90.0
		var turn_end: Transform3D = Transform3D(Basis(rest.turn_axis, deg_to_rad(angle)), Vector3.ZERO)
		var turn_mid: Transform3D = Transform3D(Basis(rest.turn_axis, deg_to_rad(angle * 0.5)), Vector3(0, 0, 0.25))
		var contacts: Dictionary = {}
		for hoof: String in rest.chains:
			var middle: Transform3D = turn_mid * middle_globals[hoof]
			contacts[hoof] = {"offset": Transform3D.IDENTITY, "segments": [
				_segment(0.0, 0.5, entry_globals[hoof], middle),
				_segment(0.5, 1.0, middle, turn_end * exit_globals[hoof])]}
		for phase: float in [0.0, 0.5, 1.0]:
			var current: Dictionary = entry if phase == 0.0 else (exit_pose if phase == 1.0 else middle_pose)
			var pose: Dictionary = {"locals": current, "entry": entry, "exit": exit_pose}
			var before: Dictionary = pose.duplicate(true)
			var op: Dictionary = _operation(angle, phase, 350.0)
			op.entry_phase = first.phase
			op.exit_phase = last.phase
			var result: Dictionary = _sample(rest, pose, op, contacts)
			assert_true(result.ok, "native sample " + str(index) + " phase " + str(phase) + " " + str(result.diagnostics))
			if not result.ok:
				continue
			if phase == 0.0 or phase == 1.0:
				assert_eq(result.locals, current, "Full native locals/skin equality on arbitrary entry AND exit")
			else:
				_assert_native_affines_and_nonlimbs(rest, current, result)
			assert_eq(pose, before)


func test_stance_swing_C1_and_continuous_joint_bend_planes() -> void:
	var fixture: Dictionary = _synthetic_case()
	var rest: Dictionary = fixture.rest
	var contacts: Dictionary = _contacts(rest, fixture.native, 30.0)
	for hoof: String in ["FrontHoof.L", "FrontHoof.R"]:
		var original: Dictionary = contacts[hoof].segments[0]
		contacts[hoof].segments = [_segment(0.0, 0.5, original.from, original.from, "stance"),
			_segment(0.5, 1.0, original.from, original.to)]
	var states: Array[Dictionary] = []
	var world_states: Array[Dictionary] = []
	var h: float = 0.01
	for phase: float in [0.5 - 2 * h, 0.5 - h, 0.5, 0.5 + h, 0.5 + 2 * h]:
		var result: Dictionary = _sample(rest, _pose(fixture.native), _operation(30.0, phase), contacts)
		assert_true(result.ok, "boundary phase " + str(phase) + " " + str(result.diagnostics))
		if not result.ok:
			return
		states.append(result.locals)
		var globals: Dictionary = _globals(rest, result.locals)
		var turn: Transform3D = Transform3D(Basis(Vector3.UP, deg_to_rad(30.0 * phase)), Vector3.ZERO)
		var world: Dictionary = {}
		for name: String in globals:
			world[name] = turn * globals[name]
		world_states.append(world)
	for hoof: String in ["FrontHoof.L", "FrontHoof.R"]:
		var left: Vector3 = (world_states[2][hoof].origin * 3 - world_states[1][hoof].origin * 4 + world_states[0][hoof].origin) / (2 * h)
		var right: Vector3 = (-world_states[2][hoof].origin * 3 + world_states[3][hoof].origin * 4 - world_states[4][hoof].origin) / (2 * h)
		assert_almost_eq(left.length(), 0.0, 0.01, hoof + " declared zero stance derivative")
		assert_almost_eq(right.length(), 0.0, 0.01, hoof + " declared zero swing entry derivative")
		for axis: int in 3:
			left = (world_states[2][hoof].basis[axis] * 3 - world_states[1][hoof].basis[axis] * 4 + world_states[0][hoof].basis[axis]) / (2 * h)
			right = (-world_states[2][hoof].basis[axis] * 3 + world_states[3][hoof].basis[axis] * 4 - world_states[4][hoof].basis[axis]) / (2 * h)
			assert_almost_eq(left.length(), 0.0, 0.01, hoof + " declared zero angular/affine derivative")
			assert_almost_eq(right.length(), 0.0, 0.01, hoof + " declared zero angular/affine derivative")
	for chain: Dictionary in rest.chains.values():
		for name: String in chain.bones:
			for axis: int in 3:
				var left: Vector3 = (states[2][name].basis[axis] * 3 - states[1][name].basis[axis] * 4 + states[0][name].basis[axis]) / (2 * h)
				var right: Vector3 = (-states[2][name].basis[axis] * 3 + states[3][name].basis[axis] * 4 - states[4][name].basis[axis]) / (2 * h)
				assert_almost_eq(left.distance_to(right), 0.0, 0.02, name + " local C1")
		for i: int in range(1, chain.bones.size() - 1):
			var previous: Vector3 = Vector3.ZERO
			for world: Dictionary in world_states:
				var a: Vector3 = world[chain.bones[i]].origin - world[chain.bones[i - 1]].origin
				var b: Vector3 = world[chain.bones[i + 1]].origin - world[chain.bones[i]].origin
				var normal: Vector3 = a.cross(b).normalized()
				if previous != Vector3.ZERO:
					assert_gt(normal.dot(previous), 0.99, chain.bones[i] + " stable bend plane")
				previous = normal
	var bad: Dictionary = contacts.duplicate(true)
	bad["FrontHoof.L"].segments[1].from_derivative.origin = Vector3(0.1, 0, 0)
	_assert_rejected(rest, _pose(fixture.native), _operation(30.0, 0.5), bad, "FrontHoof.L:contact_C1_boundary")


func test_canonical_float32_signed_pi_limits_accept_without_expanding_the_vector_domain() -> void:
	# Vector2 components round PI to 3.141592741012573; scalar PI is double.
	# Rejecting that canonical vector blocked every positive fixture before IK.
	var fixture: Dictionary = _synthetic_case()
	var rest: Dictionary = fixture.rest
	var pose: Dictionary = _pose(fixture.native)
	var op: Dictionary = _operation(0.0, 0.5)
	var contacts: Dictionary = _contacts(rest, fixture.native, 0.0)
	var result: Dictionary = _sample(rest, pose, op, contacts)
	assert_true(result.ok, "Canonical signed PI Vector2 must be valid: " + str(result.diagnostics))
	if result.ok:
		assert_eq(result.locals, fixture.native)
	for outside: Vector2 in [Vector2(-PI - 0.000001, PI), Vector2(-PI, PI + 0.000001)]:
		var bad: Dictionary = rest.duplicate(true)
		bad.chains["FrontHoof.L"].bend_limits[0] = outside
		var rejected: Dictionary = _sample(bad, pose, op, contacts)
		assert_false(rejected.ok)
		assert_eq(rejected.locals, {})
		assert_eq(rejected.diagnostics.reason, "bend_limit", "Still reject values outside the canonical Vector2 domain")


func _freeze_bind_globals(bones: Array) -> void:
	# Fixture authoring only, called before inputs are frozen; never in sample.
	var globals: Dictionary = {}
	for bone: Dictionary in bones:
		globals[bone.name] = bone.bind if bone.parent == "" else globals[bone.parent] * bone.bind
		bone.bind_global = globals[bone.name]


func test_native_pose_cannot_replace_immutable_bind_even_when_local_anatomy_stays_connected() -> void:
	var fixture: Dictionary = _native_case()
	var rest: Dictionary = fixture.rest
	var native: Dictionary = fixture.native
	var contacts: Dictionary = _contacts(rest, native, 90.0)
	var pose: Dictionary = _pose(native)
	var op: Dictionary = _operation(90.0, 0.0)
	var valid: Dictionary = _sample(rest, pose, op, contacts)
	assert_true(valid.ok, str(valid.diagnostics))
	if not valid.ok:
		return
	var laundered: Dictionary = rest.duplicate(true)
	for bone: Dictionary in laundered.bones:
		bone.bind = native[bone.name]
	_assert_rejected(laundered, pose, op, contacts, "bind_global_mismatch")
	# A twist about a bone's anatomical axis can retain head/tail positions;
	# the immutable full global affine reference must detect it too.
	laundered = rest.duplicate(true)
	for bone: Dictionary in laundered.bones:
		if bone.name == "FrontHoof.L":
			bone.bind.basis = bone.bind.basis * Basis(Vector3.UP, 0.2)
	_assert_rejected(laundered, pose, op, contacts, "bind_global_mismatch")


func test_cycles_nearly_unit_axis_and_explicit_schema_negatives_have_specific_reasons() -> void:
	var fixture: Dictionary = _synthetic_case()
	var rest: Dictionary = fixture.rest
	var pose: Dictionary = _pose(fixture.native)
	var op: Dictionary = _operation(0.0, 0.5)
	var contacts: Dictionary = _contacts(rest, fixture.native, 0.0)
	var valid: Dictionary = _sample(rest, pose, op, contacts)
	assert_true(valid.ok, str(valid.diagnostics))
	if not valid.ok:
		return
	var cycle: Dictionary = {}
	cycle["cycle"] = cycle
	_assert_rejected(cycle, pose, op, contacts, "nonfinite_or_raw_type")
	cycle.clear()
	var bad: Dictionary = rest.duplicate(true)
	bad.turn_axis = Vector3(0, 1.000009, 0)
	_assert_rejected(bad, pose, op, contacts, "rest_schema")
	var rounded_unit: Dictionary = rest.duplicate(true)
	rounded_unit.turn_axis = Vector3(1, 2, 3).normalized()
	var rounded_result: Dictionary = _sample(rounded_unit, pose, op, contacts)
	assert_true(rounded_result.ok, "A representable normalized non-axis vector remains valid: " + str(rounded_result.diagnostics))
	bad = rest.duplicate(true)
	bad.chains["FrontHoof.L"].bend_normals[0] *= 1.000009
	_assert_rejected(bad, pose, op, contacts, "bend_limit")
	bad = rest.duplicate(true)
	bad.chains["FrontHoof.L"]["unknown"] = 0.0
	_assert_rejected(bad, pose, op, contacts, "chain_schema")
	bad = rest.duplicate(true)
	bad.bones[0].head = Vector3(NAN, 0, 0)
	_assert_rejected(bad, pose, op, contacts, "nonfinite_or_raw_type")
	var bad_contacts: Dictionary = contacts.duplicate(true)
	bad_contacts["FrontHoof.L"].offset.basis = Basis(Vector3.ZERO, Vector3.UP, Vector3.BACK)
	_assert_rejected(rest, pose, op, bad_contacts, "FrontHoof.L:contact_schema")
	bad_contacts = contacts.duplicate(true)
	bad_contacts["FrontHoof.L"].segments[0].from.origin += Vector3(0.1, 0, 0)
	_assert_rejected(rest, pose, op, bad_contacts, "FrontHoof.L:incompatible_native_endpoint")
	bad_contacts = contacts.duplicate(true)
	bad_contacts["FrontHoof.L"].segments[0].mode = "stance"
	bad_contacts["FrontHoof.L"].segments[0].to.origin += Vector3(0.1, 0, 0)
	_assert_rejected(rest, pose, op, bad_contacts, "FrontHoof.L:stance_not_constant")
	bad = rest.duplicate(true)
	bad.chains["FrontHoof.L"].bend_limits[0] = Vector2(0.1, 0.2)
	_assert_rejected(bad, pose, op, contacts, "FrontHoof.L:native_joint_limits")


func test_swing_C1_preserves_declared_nonparallel_angular_derivatives_in_full_contact_frame() -> void:
	var fixture: Dictionary = _synthetic_case()
	var rest: Dictionary = fixture.rest
	var native: Dictionary = fixture.native
	var contacts: Dictionary = _contacts(rest, native, 0.0)
	var orientation: Basis = Basis(Vector3.UP, 0.3)
	var omega: Vector3 = Vector3(0.5, 0.2, -0.4)
	var derivative: Transform3D = Transform3D(Basis(omega.cross(orientation.x),
		omega.cross(orientation.y), omega.cross(orientation.z)), Vector3.ZERO)
	for contact: Dictionary in contacts.values():
		var first: Transform3D = contact.segments[0].from
		var middle: Transform3D = Transform3D(orientation, first.origin)
		var incoming: Dictionary = _segment(0.0, 0.5, first, middle)
		var outgoing: Dictionary = _segment(0.5, 1.0, middle, first)
		incoming.to_derivative = derivative
		outgoing.from_derivative = derivative
		contact.segments = [incoming, outgoing]
	var h: float = 0.01
	var states: Array[Dictionary] = []
	for phase: float in [0.5 - 2 * h, 0.5 - h, 0.5, 0.5 + h, 0.5 + 2 * h]:
		var result: Dictionary = _sample(rest, _pose(native), _operation(0.0, phase), contacts)
		assert_true(result.ok, "Nonparallel angular derivative phase " + str(phase) + " " + str(result.diagnostics))
		if not result.ok:
			return
		_assert_native_affines_and_nonlimbs(rest, native, result)
		states.append(_globals(rest, result.locals))
	for hoof: String in rest.chains:
		for axis: int in 3:
			var left: Vector3 = (states[2][hoof].basis[axis] * 3 - states[1][hoof].basis[axis] * 4 + states[0][hoof].basis[axis]) / (2 * h)
			var right: Vector3 = (-states[2][hoof].basis[axis] * 3 + states[3][hoof].basis[axis] * 4 - states[4][hoof].basis[axis]) / (2 * h)
			var expected: Vector3 = omega.cross(orientation[axis])
			assert_almost_eq(left.distance_to(expected), 0.0, 0.01, hoof + " full affine exit tangent")
			assert_almost_eq(right.distance_to(expected), 0.0, 0.01, hoof + " full affine entry tangent")


func _offset_head_case(all_limbs: bool = false) -> Dictionary:
	var fixture: Dictionary = _synthetic_case()
	var limb_names: Array = []
	for chain: Dictionary in fixture.rest.chains.values():
		limb_names.append_array(chain.bones)
	for bone: Dictionary in fixture.rest.bones:
		if bone.name == "FrontForearm.L" or (all_limbs and bone.name in limb_names):
			bone.head = Vector3(0.1, 0, 0)
			bone.bind.origin -= bone.bind.basis * bone.head
		fixture.native[bone.name] = bone.bind
	_freeze_bind_globals(fixture.rest.bones)
	return fixture


func _assert_first_heads_anchored(rest: Dictionary, native: Dictionary, solved: Dictionary) -> void:
	var before: Dictionary = _globals(rest, native)
	var after: Dictionary = _globals(rest, solved)
	for chain: Dictionary in rest.chains.values():
		var name: String = chain.bones[0]
		for bone: Dictionary in rest.bones:
			if bone.name == name:
				assert_almost_eq((after[name] * bone.head).distance_to(before[name] * bone.head), 0.0, 0.00001, name + " native attachment")


func test_review_R1_nonzero_head_keeps_full_anatomical_connectivity_and_native_origins() -> void:
	# Review reproduced ok=true with a 0.0167493317m Forearm head/tail gap.
	var fixture: Dictionary = _offset_head_case()
	var rest: Dictionary = fixture.rest
	var native: Dictionary = fixture.native
	var before: Dictionary = fixture.duplicate(true)
	for angle: float in [90.0, -90.0]:
		var contacts: Dictionary = _contacts(rest, native, angle)
		for phase: float in [0.0, 0.5, 1.0]:
			var result: Dictionary = _sample(rest, _pose(native), _operation(angle, phase), contacts)
			assert_true(result.ok, "Legal offset-head contact must solve: " + str(result.diagnostics))
			if not result.ok:
				continue
			_assert_native_affines_and_nonlimbs(rest, native, result)
			_assert_first_heads_anchored(rest, native, result.locals)
			if phase == 0.0 or phase == 1.0:
				assert_eq(result.locals, native)
	assert_eq(fixture, before)


func _assert_offset_head_twists(fixture: Dictionary) -> void:
	var rest: Dictionary = fixture.rest
	var native: Dictionary = fixture.native
	var legal: Dictionary = native.duplicate(true)
	for chain: Dictionary in rest.chains.values():
		for i: int in chain.bones.size():
			var name: String = chain.bones[i]
			# Rotation about native basis*head fixes the actual head while
			# retaining local origin and full local affine metric.
			var head: Vector3 = Vector3.ZERO
			for bone: Dictionary in rest.bones:
				if bone.name == name:
					head = bone.head
			var axis: Vector3 = (native[name].basis * head).normalized()
			legal[name].basis = Basis(axis, 0.07 if i % 2 == 0 else -0.11) * native[name].basis
	var first: Dictionary = _globals(rest, native)
	var middle: Dictionary = _globals(rest, legal)
	var end_turn: Transform3D = Transform3D(Basis(Vector3.UP, PI / 2), Vector3.ZERO)
	var mid_turn: Transform3D = Transform3D(Basis(Vector3.UP, PI / 4), Vector3.ZERO)
	var contacts: Dictionary = {}
	for hoof: String in rest.chains:
		contacts[hoof] = {"offset": Transform3D.IDENTITY, "segments": [
			_segment(0.0, 0.5, first[hoof], mid_turn * middle[hoof]),
			_segment(0.5, 1.0, mid_turn * middle[hoof], end_turn * first[hoof])]}
	var result: Dictionary = _sample(rest, _pose(native), _operation(90.0, 0.5), contacts)
	assert_true(result.ok, "Explicit feasible offset-head target must solve: " + str(result.diagnostics))
	if result.ok:
		_assert_native_affines_and_nonlimbs(rest, native, result)
		_assert_first_heads_anchored(rest, native, result.locals)

		var actual: Dictionary = _globals(rest, result.locals)
		for hoof: String in rest.chains:
			var target: Transform3D = mid_turn * middle[hoof]
			var observed: Transform3D = mid_turn * actual[hoof]
			assert_almost_eq(observed.origin.distance_to(target.origin), 0.0, 0.00001, hoof + " offset-head contact")
			for axis: int in 3:
				assert_almost_eq(observed.basis[axis].distance_to(target.basis[axis]), 0.0, 0.00001, hoof + " offset-head orientation")


func test_all18_offset_heads_solve_known_legal_twists_without_disconnecting_body_attachments() -> void:
	_assert_offset_head_twists(_offset_head_case(true))


func test_offset_heads_keep_connections_and_contacts_under_affine_parents_and_native_shear() -> void:
	var fixture: Dictionary = _offset_head_case(true)
	for bone: Dictionary in fixture.rest.bones:
		if bone.name in ["Chest", "Pelvis"]:
			bone.bind.basis = Basis(Vector3(1.6, 0.1, 0), Vector3(0.25, 0.8, 0.1), Vector3(0, 0, 1.3))
		if bone.name == "FrontForearm.L":
			bone.bind.origin += bone.bind.basis * bone.head
			bone.bind.basis = Basis(Vector3(1.15, 0.05, 0), Vector3(0.05, 0.9, 0.04), Vector3(0, 0.04, 1.25))
			bone.bind.origin -= bone.bind.basis * bone.head
		fixture.native[bone.name] = bone.bind
	_freeze_bind_globals(fixture.rest.bones)
	_assert_offset_head_twists(fixture)
