{
  "categories": {
    "simulation": {
      "opt_in": true,
      "reason": "Year-long campaigns and save/reload replays; request explicitly when campaign outcomes or determinism are the acceptance.",
      "patterns": ["tests/simulation/test_*.gd", "tests/engine/test_determinism.gd", "tests/engine/test_supply_garrisons.gd"]
    },
    "gameplay": {
      "opt_in": true,
      "reason": "Authored invasion, clearance, raiding and siege scenarios played through the real campaign day loop; mixed scenario suites retain all assertions under explicit opt-in.",
      "patterns": ["tests/gameplay/test_*.gd", "tests/engine/test_invasion_end_to_end.gd", "tests/engine/test_sighting_invasion.gd", "tests/engine/test_army_clearance.gd", "tests/engine/test_raid.gd", "tests/engine/test_siege.gd"]
    },
    "balance": {
      "opt_in": true,
      "reason": "Reserved for tuning/outcome sweeps; single-formula hand-computed assertions remain functional.",
      "patterns": ["tests/balance/test_*.gd"]
    },
    "engine-military": {
      "ci_batches": 4,
      "reason": "Army, battle, movement, supply, conduct and field-order functional contracts, including formula and local save tests.",
      "patterns": ["tests/engine/test_army_*.gd", "tests/engine/test_battle_*.gd", "tests/engine/test_camp_*.gd", "tests/engine/test_conduct_*.gd", "tests/engine/test_courier_*.gd", "tests/engine/test_march_*.gd", "tests/engine/test_military_*.gd", "tests/engine/test_prisoner_*.gd", "tests/engine/test_supply_*.gd", "tests/engine/test_war_*.gd", "tests/engine/test_enemy_*.gd", "tests/engine/test_foe_*.gd", "tests/engine/test_siege*.gd", "tests/engine/test_sighting*.gd", "tests/engine/test_raid*.gd", "tests/engine/test_forage.gd", "tests/engine/test_desertion.gd", "tests/engine/test_defeat.gd", "tests/engine/test_recruitment.gd", "tests/engine/test_scouting.gd", "tests/engine/test_roster_guard.gd", "tests/engine/test_unit_bodies.gd", "tests/engine/test_body_motion.gd"]
    },
    "engine-economy": {
      "reason": "Whole-gold formulas, settlement, manor ownership, industry, trade, law and ledger data contracts.",
      "patterns": ["tests/engine/test_manor_*.gd", "tests/engine/test_map_*.gd", "tests/engine/test_law_*.gd", "tests/engine/test_ledger_*.gd", "tests/engine/test_workshop_*.gd", "tests/engine/test_town_*.gd", "tests/engine/test_*economy.gd", "tests/engine/test_artisans.gd", "tests/engine/test_industry.gd", "tests/engine/test_markets.gd", "tests/engine/test_govern*.gd", "tests/engine/test_population_*.gd"]
    },
    "engine-core": {
      "reason": "Remaining functional engine/data/story contracts, local determinism and save-format assertions. Expensive content above overrides this fallback.",
      "patterns": ["tests/engine/test_*.gd"]
    },
    "map3d": {"reason": "Map rendering, asset and interaction contracts; sorted together to preserve hover/picker setup order.", "patterns": ["tests/map3d/test_*.gd"]},
    "ui": {"reason": "Screen and Game bridge functional contracts.", "patterns": ["tests/ui/test_*.gd"]},
    "ledger3d": {"reason": "Ledger layout, assets and interaction contracts.", "patterns": ["tests/ledger3d/test_*.gd"]},
    "war_room": {"reason": "War room drawing and interaction contracts.", "patterns": ["tests/war_room/test_*.gd"]}
  },
  "routes": [
    {"patterns": ["scripts/ui/*", "scenes/screens/*", "scenes/hud/*", "scenes/panels/*"], "categories": ["ui", "map3d", "ledger3d", "war_room"]},
    {"patterns": ["scripts/map3d/*", "scenes/map3d/*", "tools/map3d/*"], "categories": ["engine-economy", "map3d", "ui"]},
    {"patterns": ["scripts/ledger3d/*", "scenes/ledger3d/*", "tools/ledger/*"], "categories": ["engine-economy", "ledger3d", "ui"]},
    {"patterns": ["scripts/war_room/*", "scenes/war_room/*", "tools/war_room/*"], "categories": ["engine-military", "war_room", "ui"]},
    {"patterns": ["scripts/llm/*"], "categories": ["engine-core", "ui"]}
  ]
}
