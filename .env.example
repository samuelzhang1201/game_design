# Crown and Council — LLM configuration (copy to .env and fill in).
# .env is git-ignored; never commit real secrets.
OPENAI_API_KEY=
# Informational label for which key/project this config is (shown in logs
# and debug UI only — never sent to the API):
OPENAI_API_NAME=game_dev
# One model for all tiers...
LLM_MODEL=gpt-4o-mini-2024-07-18
# ...or per-tier overrides (optional):
#LLM_MODEL_PARSE=
# The two-part order call (narrative + impacts); defaults to the parse tier:
#LLM_MODEL_ORDER=
#LLM_MODEL_VOICE=
#LLM_MODEL_FLAGSHIP=
# Response size cap (resource limit):
#LLM_MAX_OUTPUT_TOKENS=600
# Reasoning-model budget. REQUIRED (e.g. minimal) with gpt-5-family/o-series
# models — their default effort can burn the whole output cap on hidden
# reasoning and return empty dialogue. Only sent to models that accept it,
# so it is safe to keep set while switching LLM_MODEL.
#LLM_REASONING_EFFORT=minimal
# 1/true: send "store": true so requests appear on platform.openai.com/logs
# (off by default — stored requests are retained by OpenAI ~30 days):
#LLM_STORE_REQUESTS=1
