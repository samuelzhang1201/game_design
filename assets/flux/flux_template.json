{
  "_comment": "ComfyUI API-format graph for Flux.1 (schnell now; dev would fit the same graph but is non-commercial, see README). generate.py fills the slots listed in _slots per row of prompts.csv. Flux.1 has no negative-prompt path: node 6 zeroes the conditioning.",
  "_slots": {
    "unet": [["1", "unet_name"]],
    "prompt": [["4", "text"]],
    "guidance": [["5", "guidance"]],
    "width": [["7", "width"]],
    "height": [["7", "height"]],
    "seed": [["8", "seed"]],
    "steps": [["8", "steps"]],
    "prefix": [["10", "filename_prefix"]]
  },
  "1": {
    "class_type": "UNETLoader",
    "_meta": {"title": "Flux model"},
    "inputs": {"unet_name": "{{UNET}}", "weight_dtype": "default"}
  },
  "2": {
    "class_type": "DualCLIPLoader",
    "_meta": {"title": "T5 + CLIP-L"},
    "inputs": {"clip_name1": "t5xxl_fp16.safetensors", "clip_name2": "clip_l.safetensors", "type": "flux"}
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {"title": "Flux VAE"},
    "inputs": {"vae_name": "ae.safetensors"}
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Prompt = STYLE_CORE + subject + canvas"},
    "inputs": {"text": "{{PROMPT}}", "clip": ["2", 0]}
  },
  "5": {
    "class_type": "FluxGuidance",
    "_meta": {"title": "Guidance (dev: 2.5-3.5; schnell ignores it)"},
    "inputs": {"guidance": 3.0, "conditioning": ["4", 0]}
  },
  "6": {
    "class_type": "ConditioningZeroOut",
    "_meta": {"title": "Empty negative (Flux has no negative prompt path)"},
    "inputs": {"conditioning": ["4", 0]}
  },
  "7": {
    "class_type": "EmptySD3LatentImage",
    "_meta": {"title": "Canvas"},
    "inputs": {"width": 1024, "height": 1024, "batch_size": 1}
  },
  "8": {
    "class_type": "KSampler",
    "_meta": {"title": "Sampler (schnell: 4 steps; dev: 28-35)"},
    "inputs": {
      "seed": 0,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["7", 0]
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "_meta": {"title": "Decode"},
    "inputs": {"samples": ["8", 0], "vae": ["3", 0]}
  },
  "10": {
    "class_type": "SaveImage",
    "_meta": {"title": "Save (prefix = chapter/ID)"},
    "inputs": {"filename_prefix": "{{PREFIX}}", "images": ["9", 0]}
  }
}
