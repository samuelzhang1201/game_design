{
  "_comment": "ComfyUI API-format graph for Flux.2 [klein] 4B base (Apache 2.0, commercial OK). Undistilled, so CFG works and NEGATIVE.txt is really applied. generate.py fills the slots listed in _slots per row of prompts.csv.",
  "_slots": {
    "unet": [["1", "unet_name"]],
    "prompt": [["4", "text"]],
    "negative": [["5", "text"]],
    "cfg": [["6", "cfg"]],
    "steps": [["7", "steps"]],
    "width": [["7", "width"], ["8", "width"]],
    "height": [["7", "height"], ["8", "height"]],
    "seed": [["9", "noise_seed"]],
    "prefix": [["13", "filename_prefix"]]
  },
  "1": {
    "class_type": "UNETLoader",
    "_meta": {"title": "Flux.2 klein 4B base"},
    "inputs": {"unet_name": "flux-2-klein-base-4b.safetensors", "weight_dtype": "default"}
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "Qwen3 4B text encoder"},
    "inputs": {"clip_name": "qwen_3_4b.safetensors", "type": "flux2", "device": "default"}
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {"title": "Flux.2 VAE"},
    "inputs": {"vae_name": "flux2-vae.safetensors"}
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Prompt = STYLE_CORE + subject + canvas"},
    "inputs": {"text": "{{PROMPT}}", "clip": ["2", 0]}
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Negative = NEGATIVE.txt"},
    "inputs": {"text": "{{NEGATIVE}}", "clip": ["2", 0]}
  },
  "6": {
    "class_type": "CFGGuider",
    "_meta": {"title": "CFG (library: 3.5-4.5 for a CFG model)"},
    "inputs": {"cfg": 4.0, "model": ["1", 0], "positive": ["4", 0], "negative": ["5", 0]}
  },
  "7": {
    "class_type": "Flux2Scheduler",
    "_meta": {"title": "Sigmas"},
    "inputs": {"steps": 20, "width": 1024, "height": 1024}
  },
  "8": {
    "class_type": "EmptyFlux2LatentImage",
    "_meta": {"title": "Canvas"},
    "inputs": {"width": 1024, "height": 1024, "batch_size": 1}
  },
  "9": {
    "class_type": "RandomNoise",
    "_meta": {"title": "Seed"},
    "inputs": {"noise_seed": 0}
  },
  "10": {
    "class_type": "KSamplerSelect",
    "_meta": {"title": "Sampler"},
    "inputs": {"sampler_name": "euler"}
  },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "_meta": {"title": "Sample"},
    "inputs": {"noise": ["9", 0], "guider": ["6", 0], "sampler": ["10", 0], "sigmas": ["7", 0], "latent_image": ["8", 0]}
  },
  "12": {
    "class_type": "VAEDecode",
    "_meta": {"title": "Decode"},
    "inputs": {"samples": ["11", 0], "vae": ["3", 0]}
  },
  "13": {
    "class_type": "SaveImage",
    "_meta": {"title": "Save (prefix = chapter/ID)"},
    "inputs": {"filename_prefix": "{{PREFIX}}", "images": ["12", 0]}
  }
}
