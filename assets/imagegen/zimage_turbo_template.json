{
  "_comment": "ComfyUI API-format graph for Z-Image Turbo (Tongyi-MAI, 6B, Apache 2.0, commercial OK). Step-distilled: 8 steps, CFG 1, so there is NO negative-prompt path (the negative is ConditioningZeroOut of the prompt, as in ComfyUI's own image_z_image_turbo template) and NEGATIVE.txt is not applied. Shares qwen_3_4b.safetensors (type lumina2) and ae.safetensors with nothing else to download. generate.py fills the slots listed in _slots per row of prompts.csv.",
  "_slots": {
    "unet": [["1", "unet_name"]],
    "prompt": [["4", "text"]],
    "cfg": [["8", "cfg"]],
    "steps": [["8", "steps"]],
    "width": [["7", "width"]],
    "height": [["7", "height"]],
    "seed": [["8", "seed"]],
    "prefix": [["10", "filename_prefix"]]
  },
  "1": {
    "class_type": "UNETLoader",
    "_meta": {"title": "Z-Image Turbo bf16"},
    "inputs": {"unet_name": "z_image_turbo_bf16.safetensors", "weight_dtype": "default"}
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "Qwen3 4B text encoder"},
    "inputs": {"clip_name": "qwen_3_4b.safetensors", "type": "lumina2", "device": "default"}
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {"title": "Z-Image VAE (ae.safetensors, the FLUX.1 autoencoder Z-Image ships with)"},
    "inputs": {"vae_name": "ae.safetensors"}
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Prompt = STYLE_CORE + subject + canvas"},
    "inputs": {"text": "{{PROMPT}}", "clip": ["2", 0]}
  },
  "5": {
    "class_type": "ConditioningZeroOut",
    "_meta": {"title": "No negative (distilled, CFG 1)"},
    "inputs": {"conditioning": ["4", 0]}
  },
  "6": {
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {"title": "Shift 3 (ComfyUI template)"},
    "inputs": {"shift": 3, "model": ["1", 0]}
  },
  "7": {
    "class_type": "EmptySD3LatentImage",
    "_meta": {"title": "Canvas"},
    "inputs": {"width": 1024, "height": 1024, "batch_size": 1}
  },
  "8": {
    "class_type": "KSampler",
    "_meta": {"title": "Sample (8 steps, CFG 1, res_multistep)"},
    "inputs": {"seed": 0, "steps": 8, "cfg": 1.0, "sampler_name": "res_multistep", "scheduler": "simple",
               "denoise": 1.0, "model": ["6", 0], "positive": ["4", 0], "negative": ["5", 0], "latent_image": ["7", 0]}
  },
  "9": {
    "class_type": "VAEDecode",
    "_meta": {"title": "Decode"},
    "inputs": {"samples": ["8", 0], "vae": ["3", 0]}
  },
  "10": {
    "class_type": "SaveImage",
    "_meta": {"title": "Save (prefix = chapter/ID)"},
    "inputs": {"filename_prefix": "{{PREFIX}}", "images": ["9", 0]}
  }
}
